# ── GitHub API Tokens ──
# Get from: https://github.com/settings/tokens
# Needs: public_repo, read:user scopes
GITHUB_TOKEN=ghp_your_primary_token_here
# Optional: Add more tokens for higher rate limits (5000 req/hr per token)
GITHUB_TOKEN_2=ghp_your_second_token_here
# Or comma-separated: GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3
GITHUB_TOKENS=

# ── Gemini AI (Required) ──
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Redis Cache (Optional, improves performance) ──
# For local: redis://localhost:6379/0
# For Railway/Render: provided automatically
REDIS_URL=redis://localhost:6379/0

# ── CORS (Production) ──
# Set to your Vercel/production frontend URL
FRONTEND_URL=https://your-app.vercel.app

# ── Environment ──
ENVIRONMENT=development
