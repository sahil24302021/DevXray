# ═══════════════════════════════════════════════════════
#  DevSignal AI — Environment Variables
# ═══════════════════════════════════════════════════════

# Required — powers resume parsing and AI summary
GEMINI_API_KEY=your_gemini_key

# Strongly recommended (+12% accuracy via LinkedIn cross-reference)
RAPIDAPI_KEY=your_rapidapi_key

# Recommended — higher rate limits for GitHub API
# Single token:
GITHUB_TOKEN=your_github_token
# OR multiple tokens for round-robin rotation (5000 req/hr per token):
GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3

# Optional — improves Stack Overflow rate limits
SO_API_KEY=your_stackoverflow_key

# Deprecated — do not use (Proxycurl was shut down Jan 2025)
# PROXYCURL_API_KEY=
