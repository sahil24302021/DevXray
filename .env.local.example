# ── Backend API URL ──
# Development: http://localhost:8000
# Docker: http://backend:8000
# Production (Railway/Render): https://your-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Clerk Auth (Optional — app works without this) ──
# Get from: https://clerk.com → Create application
# Without this, auth is bypassed in development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here

# ── Supabase (Optional — falls back to localStorage without this) ──
# Get from: https://supabase.com → New project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
